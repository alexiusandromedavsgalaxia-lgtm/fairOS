#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "fair install FILE"
  echo "fair list"
}

if [ "$#" -eq 0 ]; then
  usage
  exit 2
fi

case "$1" in
  install)
    [ "$#" -ge 2 ] || { usage; exit 2; }
    file="$2"
    case "$file" in
      *.arch) pacman -U "$file" ;;
      *.pkg.tar.zst|*.pkg.tar.xz) pacman -U "$file" ;;
      *.deb) dpkg --install "$file" ;;
      *.fair) echo ".fair package: $file" ;;
      *) echo "unsupported package: $file" >&2; exit 2 ;;
    esac
    ;;
  list)
    pacman -Q
    ;;
  *)
    usage
    exit 2
    ;;
esac
